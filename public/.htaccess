# Send every route to index.html so React Router can handle it (fixes 404 on refresh)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Un-hashed static files (logo, icons, banner.jpg): cache for 7 days.
  <FilesMatch "\.(js|mjs|css|woff2?|ttf|otf|png|jpe?g|gif|svg|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # Vite build output carries a content hash in the name (e.g. index-Bhgd9AGC.js),
  # so a changed file always gets a new URL: cache it for a year. Must stay after the rule above.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|mjs|css|woff2?|ttf|otf|png|jpe?g|gif|svg|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Last, so they win over the rules above.
  # The app shell must always be revalidated so a new deploy's hashed bundles are picked up
  # (SPA routes are rewritten to index.html, so this covers them too).
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>

  # The push service worker must always be revalidated so updates reach browsers.
  <Files "firebase-messaging-sw.js">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
